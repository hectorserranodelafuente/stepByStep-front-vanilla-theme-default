
<!DOCTYPE html>
<html lang="es">
<head>
  
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Loading</title>
  <!--  Simple reset to delete the margins  -->
  <style>
    body { margin: 0; }
    canvas { width: 1000px; height: 1000px}
    @media (min-width: 480px) {
      
      .responsive{  

        height:'0px';
        display:block;
      
      }

     
    }

    
    @media (max-width: 480px) {
      
      .responsive{
        
        height:'0px';
        display:none;   
      
      }

       .loadingText{
        text-align:center;
      }
    
    }
  </style>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r83/three.min.js"></script>

</head>
<body>
  <div id="loadingText" class="loadingText"></div>
  <div id="responsive" class="responsive"></div>
  <%- include('../renderedHead/head.ejs') %>
  
</body>
</html>
